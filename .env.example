# Copy to .env. The fake gateway boots with no HitPay key.
HITPAY_ENV=sandbox
HITPAY_API_KEY=
HITPAY_WEBHOOK_SALT=
HITPAY_MCP_URL=https://hitpay-mcp.vercel.app/api/mcp
TALLY_GATEWAY=fake
TALLY_DB_URL=file:./data/tally.db
TALLY_AUTO_APPROVE_REMAINDER=on
TALLY_TODAY=2026-11-17
TALLY_NOW=
APP_URL=http://127.0.0.1:43123
# Public origin HitPay can reach for webhooks. Leave empty on a laptop: a localhost webhook is rejected, and Tally omits the field until this is set.
PUBLIC_URL=
# OpenAI hints. The model only reads a bank reference and explains an uncertain match.
# It never sets an amount, allocates, or approves. Leave the key empty for the deterministic text.
# gpt-6.1-terra is called without temperature or other sampling parameters.
HINTS_API_URL=https://api.openai.com/v1
HINTS_API_KEY=
HINTS_MODEL=gpt-6.1-terra
# One hint call. gpt-6.1-terra needs more than 3 seconds. Default 20000.
HINTS_TIMEOUT_MS=20000
TALLY_STRIPE=off
# Policy editing is off by default. The dedicated launcher binds to 127.0.0.1
# and provides trusted socket context; this flag alone cannot enable network writes.
# Run: npm run dev:policy-demo
TALLY_LOCAL_POLICY_EDITS=off
