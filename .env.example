# Real sandbox template: add sandbox key/salt locally; see docs/demo.md.
HITPAY_ENV=sandbox
HITPAY_API_KEY=
HITPAY_WEBHOOK_SALT=
HITPAY_MCP_URL=https://hitpay-mcp.vercel.app/api/mcp
TALLY_GATEWAY=mcp
TALLY_DB_URL=file:./data/tally-sandbox-demo.db
TALLY_AUTO_APPROVE_REMAINDER=on
# Set to today's Singapore date before starting; payment expiry uses this date.
TALLY_TODAY=2026-11-19
TALLY_NOW=
APP_URL=http://127.0.0.1:43123
# Leave blank for local sandbox polling; do not proxy/tunnel the dev server.
PUBLIC_URL=
# OpenAI hints. The model only reads a bank reference and explains an uncertain match.
# It never sets an amount, allocates, or approves. Leave the key empty for the deterministic text.
# gpt-6.1-terra is called without temperature or other sampling parameters.
HINTS_API_URL=https://api.openai.com/v1
HINTS_API_KEY=
HINTS_MODEL=gpt-6.1-terra
# One hint call. gpt-6.1-terra needs more than 3 seconds. Default 20000.
HINTS_TIMEOUT_MS=20000
TALLY_STRIPE=off
# Choose a fresh disposable path in both DB variables; never use data/tally.db.
TALLY_DEMO_DB_URL=file:./data/tally-sandbox-demo.db
# Enables Settings and supplier mutations only for this local demo setup.
TALLY_LOCAL_LEDGER_EDITS=on
