{
  "name": "tally",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env scripts/dev-local.ts",
    "build": "next build",
    "start": "next start --port 43123",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "check:record": "node scripts/verify.mjs record",
    "test:props:long": "node scripts/verify.mjs long",
    "e2e": "vitest run tests/demo/spec-demo.test.ts",
    "smoke:sandbox": "tsx --env-file-if-exists=.env scripts/smoke-sandbox.ts",
    "db:reset": "tsx --env-file-if-exists=.env scripts/db-reset.ts",
    "seed:local": "tsx --env-file-if-exists=.env scripts/seed-local.ts",
    "doctor": "tsx --env-file-if-exists=.env scripts/doctor.ts",
    "ledger:dump": "tsx --env-file-if-exists=.env scripts/ledger-dump.ts",
    "golden:update": "tsx --env-file-if-exists=.env scripts/golden-update.ts",
    "dev:policy-demo": "tsx --env-file-if-exists=.env scripts/dev-local.ts --policy-edits"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.74.0",
    "next": "^15.5.29",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.29",
    "fast-check": "^4.10.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
